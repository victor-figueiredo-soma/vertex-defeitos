# Contem os valores SENSIVEIS (sem default em codigo, o app recusa subir sem
# eles) e o que difere do default. Todo o resto - projeto, regiao, bucket,
# modelo, resolucao de imagem, thinking budget, limiar de confianca, porta -
# ja tem default correto em config.py / app/settings.py.
#
# Ao subir no Railway, replique TODAS as variaveis abaixo no painel do servico,
# trocando GOOGLE_APPLICATION_CREDENTIALS pelo _JSON (la nao ha arquivo no disco)
# e ajustando WEBHOOK_BASE_URL para a URL publica do servico.
# ============================================================================

# --- Azure / Microsoft Graph (SENSIVEL) -------------------------------------
# App registration com application permissions Mail.Read e Mail.Send.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Caixa de e-mail monitorada (SENSIVEL).
GRAPH_MAILBOX=

# --- Modelo afinado (SENSIVEL) ----------------------------------------------
# O resource name carrega o numero do projeto GCP. Para descobrir o atual:
#   gcloud ai tuning-jobs list --region=us-central1 #     --format="value(tunedModel.endpoint)"
TUNED_ENDPOINT=

# --- Destinos de notificacao (SENSIVEL) -------------------------------------
# ERROS de execucao: assunto [vertex-defeitos ERRO].
ALERT_EMAIL=
# FILA de revisao humana: assunto [vertex-defeitos REVISAO]. Aponte para o time
# de devolucoes para separar dos erros.
REVIEW_EMAIL=

# --- Webhook (SENSIVEL) -----------------------------------------------------
# Token que valida cada notificacao do Graph. Exigido para servir o webhook e
# para `app.subscription criar`.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_CLIENT_STATE=

# URL publica, SEM barra final. Exigida por `app.subscription criar` e `renovar`.
# Local: use um tunel (ngrok http 8080). No Railway: a URL do servico.
WEBHOOK_BASE_URL=

# --- Credencial GCP (SENSIVEL) ----------------------------------------------
# Aceita as DUAS formas, distinguidas pelo conteudo:
#   LOCAL   : caminho do arquivo de chave (ex.: C:\...\sa_key.json)
#   RAILWAY : o CONTEUDO INTEIRO do JSON da Service Account (comeca com "{")
# No segundo caso o app grava num arquivo temporario, porque o ADC do Google so
# sabe consumir caminho. Vazio = tenta config.DEFAULT_SA_KEY e depois o ADC do
# ambiente.
GOOGLE_APPLICATION_CREDENTIALS=

# Alternativa explicita para o JSON, se preferir separa-lo do caminho. Vence
# quando GOOGLE_APPLICATION_CREDENTIALS aponta para arquivo INEXISTENTE - cobre o
# caso de replicar o .env local no painel, onde o caminho so existe na sua maquina.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Trava de escopo (assunto) -----------------------------------------------
# So processa e-mail cujo ASSUNTO CONTENHA este termo (ignora acento e caixa:
# "Devolucao", "DEVOLUÇÃO" e "devoluçao" casam igual). Existe porque a caixa
# monitorada recebe e-mail alheio ao fluxo - marketing, notificacoes, conversas -
# e sem o filtro qualquer mensagem com imagem seria julgada e receberia resposta
# automatica. Fora do escopo: ignorado em silencio, sem baixar anexo nem chamar o
# Vertex.
#
# VAZIO DESLIGA o filtro e processa TUDO - use com cuidado.
# Default no codigo: devolucao
ASSUNTO_FILTRO=
