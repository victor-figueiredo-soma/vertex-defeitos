# ============================================================================
# vertex-defeitos - modelo de configuracao local
#
# Copie para .env e ajuste. O .env NAO vai para o git (ver .gitignore).
#   cp .env.example .env
#
# No RAILWAY nao existe .env: configure estas variaveis no painel do servico.
# O carregador em config.py usa setdefault, entao o ambiente real SEMPRE tem
# prioridade sobre este arquivo. Linhas em branco e chaves sem valor sao
# ignoradas (vale o default do codigo).
# ============================================================================

# ----------------------------------------------------------------------------
# GCP - projeto, regiao e bucket
# ----------------------------------------------------------------------------
GCP_PROJECT=soma-ai-hub

# Sinonimo aceito pelo app (app/settings.py); se ambos definidos, este vence.
# Util no Railway, onde a spec de deploy usa este nome.
GCP_PROJECT_ID=

# Regiao do TUNING. Precisa ser us-central1 ou europe-west4 para os modelos
# Gemini 3.x - sao as unicas com endpoint de tuning declarado, e o endpoint
# 'global' NAO suporta tuning.
GCP_LOCATION=us-central1

# Nome do bucket, SEM o prefixo gs://. Precisa casar com os fileUri gravados nos
# JSONL de dataset/ (gs://<bucket>/staging/... e gs://<bucket>/staging-v3lite/...).
GCS_BUCKET=vertex-defeitos

# ----------------------------------------------------------------------------
# Credenciais GCP (Service Account - ADC, nao API key)
# ----------------------------------------------------------------------------
# LOCAL: caminho absoluto da chave JSON. Vazio = config.ensure_credentials()
# tenta o caminho padrao (config.DEFAULT_SA_KEY) e depois o ADC do ambiente.
GOOGLE_APPLICATION_CREDENTIALS=

# RAILWAY: o CONTEUDO INTEIRO do JSON da Service Account, numa linha so.
# app/settings.py materializa num arquivo temporario e aponta o ADC para ele.
# Use um OU outro - se GOOGLE_APPLICATION_CREDENTIALS estiver definido, o JSON
# inline e ignorado.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ----------------------------------------------------------------------------
# Modelo
# ----------------------------------------------------------------------------
# Modelo base do fine-tuning. NAO voltar para gemini-2.5-flash: ele retira em
# 2026-10-20 e quatro tuning jobs nele ficaram presos em JOB_STATE_RUNNING sem
# emitir um unico step. Ver README.
VERTEX_BASE_MODEL=gemini-3.1-flash-lite
VERTEX_TUNED_NAME=validador-defeitos-v3lite

# Endpoint do modelo AFINADO (resource name completo). Vazio = inferencia.py cai
# no modelo-base, que serve para exercitar o pipeline mas NAO e o validador.
# ATENCAO: e uma MULTI-REGION (locations/us), nao a regiao do job de tuning.
TUNED_ENDPOINT=projects/291753593894/locations/us/endpoints/711146528659472384

# Sinonimo aceito pelo app (spec do deploy no Railway). Aceita o resource name
# completo OU so o ID numerico (ex.: 711146528659472384) - o app monta o resto.
# Se ambos definidos, este vence dentro do app.
VERTEX_ENDPOINT_ID=

# ----------------------------------------------------------------------------
# Hiperparametros do tuning (vazio = default do Vertex)
# ----------------------------------------------------------------------------
# A doc de migracao pede para NAO reaproveitar valores entre geracoes de modelo e
# rodar o primeiro job de um modelo novo no default. O default resolveu para
# epochCount=40 / adapterSize=2 / lr=1.0 - 17,5M tokens (~US$52) para 166
# exemplos. A curva de eval ficou plana desde o step ~150, entao para re-treinar
# vale fixar VERTEX_TUNING_EPOCHS entre 5 e 8.
VERTEX_TUNING_EPOCHS=
VERTEX_TUNING_LR_MULTIPLIER=
VERTEX_TUNING_ADAPTER_SIZE=

# ----------------------------------------------------------------------------
# Inferencia
# ----------------------------------------------------------------------------
# Detalhe visual enviado ao modelo. E ESTE campo, nao a dimensao da imagem, que
# define o custo em tokens: HIGH=1290, MEDIUM=256, LOW=64 numa foto de 768px.
# TEM que casar com o gravado no JSONL de treino. Medido: MEDIUM custa 3,2pp de
# recall de deteccao, por isso HIGH.
VERTEX_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH

# Maior lado da imagem em px, aplicado em treino E inferencia (imagem.py).
IMAGEM_MAX_DIM=768

# Orcamento de thinking. 0 = minimo, o que a doc de SFT recomenda para tarefas
# afinadas. Vazio desliga o campo.
VERTEX_THINKING_BUDGET=0

# Abaixo deste valor de confianca a resposta NAO vai automatica ao cliente: ele
# recebe "em analise" e o caso vai para ALERT_EMAIL. Espelha a regra do
# system_instruction.md - mudar aqui sem mudar la desalinha os dois.
CONFIDENCE_THRESHOLD=0.70

# ----------------------------------------------------------------------------
# App do webhook (Railway) - Azure / Microsoft Graph
# ----------------------------------------------------------------------------
# App registration no Azure com APPLICATION permissions: Mail.Read e Mail.Send.
# Segredos: NUNCA commite os valores reais.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Caixa de e-mail monitorada (as app permissions permitem /users/{mailbox}).
GRAPH_MAILBOX=dados@somagrupo.com.br

# ----------------------------------------------------------------------------
# App do webhook (Railway) - webhook e alertas
# ----------------------------------------------------------------------------
# URL publica do servico (ex.: https://xxx.up.railway.app), SEM barra final.
# Usada para registrar a subscription do Graph (python -m app.subscription criar)
# e para reconhecer as nossas subscriptions no 'renovar'.
WEBHOOK_BASE_URL=

# String aleatoria LONGA combinada na criacao da subscription. Toda notificacao
# recebida e validada contra ela; item que nao bater e descartado (payload 100%
# invalido recebe 403). Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_CLIENT_STATE=

# ERROS DE EXECUCAO: Vertex ou Graph fora do ar, falha ao responder o cliente.
# Canal de "algo quebrou, alguem precisa olhar o sistema". Assunto prefixado com
# [vertex-defeitos ERRO]. Se vazio, os erros viram apenas log - NAO deixe vazio
# em producao.
ALERT_EMAIL=

# FILA DE REVISAO HUMANA: casos que o modelo nao decide sozinho (INCONCLUSIVO,
# confianca < CONFIDENCE_THRESHOLD, ou requer_revisao_manual). NAO e erro - e
# devolucao esperando julgamento: o cliente ja recebeu "em analise" e alguem
# precisa decidir e responder. Assunto prefixado com [vertex-defeitos REVISAO].
# Se vazio, cai no ALERT_EMAIL para o caso nunca morrer em silencio.
REVIEW_EMAIL=

# Porta do uvicorn. No Railway e injetada automaticamente - nao defina la.
PORT=8080

# ----------------------------------------------------------------------------
# Pipeline de dataset (so para quem regenera o dataset do zero)
# ----------------------------------------------------------------------------
# Pasta com as fotos ORIGINAIS rotuladas pelo nome do arquivo. Default:
# ../dataset_defeitos relativo a raiz do repo. Cuidado: gerar_dataset.py
# renumera tudo por indice - regerar muda nomes e split (ver README).
DATASET_ORIGEM=
