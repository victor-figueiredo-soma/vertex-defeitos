# ============================================================================
# vertex-defeitos - modelo de configuracao local
#
# Copie para .env e ajuste. O .env NAO vai para o git (ver .gitignore).
#   cp .env.example .env
#
# Em producao (Cloud Run / Cloud Run Job) NAO existe .env: as variaveis vem do
# proprio servico e os segredos do Secret Manager. O carregador em config.py
# usa setdefault, entao o ambiente real SEMPRE tem prioridade sobre o arquivo.
#
# Linhas em branco e chaves sem valor sao ignoradas (o default do codigo vale).
# ============================================================================

# ----------------------------------------------------------------------------
# GCP - projeto, regiao e bucket (config.py)
# ----------------------------------------------------------------------------
GCP_PROJECT=soma-ai-hub

# ATENCAO: o SFT do Gemini nao existe em toda regiao. us-central1 e a mais
# garantida para tuning. us-west1 esta habilitada para generateContent
# (inferencia), mas valide o tuning antes de mudar isto.
GCP_LOCATION=us-west1

# Nome do bucket, SEM o prefixo gs://. Precisa casar com os fileUri ja gravados
# nos JSONL de treino (gs://<bucket>/staging/...).
GCS_BUCKET=azzas-defeitos

# ----------------------------------------------------------------------------
# Credenciais GCP (Service Account - ADC, nao API key)
# ----------------------------------------------------------------------------
# Caminho absoluto da chave JSON. Se ficar vazio, config.ensure_credentials()
# cai no caminho padrao (config.DEFAULT_SA_KEY) e falha se nao existir.
# Em Cloud Run: DEIXE VAZIO - a identidade da SA anexada e usada automaticamente.
GOOGLE_APPLICATION_CREDENTIALS=

# ----------------------------------------------------------------------------
# Modelo / fine-tuning
# ----------------------------------------------------------------------------
VERTEX_BASE_MODEL=gemini-2.5-flash
VERTEX_TUNED_NAME=validador-defeitos-azzas

# Endpoint do modelo afinado. Prioridade de resolucao (classifier.resolve_endpoint):
#   1) esta variavel  2) Firestore config/active_model  3) modelo-base (fallback)
# Deixe VAZIO em producao para o re-treino poder trocar o modelo sem redeploy.
TUNED_ENDPOINT=

# ----------------------------------------------------------------------------
# Politica de decisao (app/settings.py)
# ----------------------------------------------------------------------------
# Abaixo deste valor de confianca, a devolucao vai para revisao humana.
# Espelha o system_instruction.md - mudar aqui sem mudar la desalinha os dois.
CONFIDENCE_THRESHOLD=0.70

# ----------------------------------------------------------------------------
# Re-treino (gatilho por lote)
# ----------------------------------------------------------------------------
# A cada N rotulos CONFIRMADOS POR HUMANO, publica no topico e dispara o job.
RETRAIN_THRESHOLD_INPUTS=100
RETRAIN_TOPIC=retrain-trigger

# ----------------------------------------------------------------------------
# Persistencia
# ----------------------------------------------------------------------------
FIRESTORE_COLLECTION=devolucoes
FIRESTORE_CONFIG_COLLECTION=config
INBOX_PREFIX=inbox

# ----------------------------------------------------------------------------
# Ingestao Outlook / Microsoft Graph
# ----------------------------------------------------------------------------
# App registration no Azure. Em producao estes tres vem do Secret Manager -
# NUNCA commite os valores reais.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GRAPH_MAILBOX=dados@somagrupo.com.br

# Token secreto combinado na criacao da subscription do Graph. O webhook rejeita
# notificacoes cujo clientState nao bata. Se vazio, a validacao e PULADA -
# defina um valor aleatorio antes de expor o endpoint publicamente.
GRAPH_CLIENT_STATE=

# ----------------------------------------------------------------------------
# Servidor local (opcional)
# ----------------------------------------------------------------------------
# Porta do Flask/gunicorn. Em Cloud Run e injetada automaticamente.
PORT=8080
